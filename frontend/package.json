{
  "name": "swu-inventory-frontend",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src e2e",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "e2e:mobile": "node e2e/run-mobile.mjs",
    "e2e:mobile:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "firebase": "^12.19.0",
    "posthog-js": "^1.421.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.31.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.13.6"
    }
  }
}
