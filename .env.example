# PostgreSQL
POSTGRES_DB=swu_inventory
POSTGRES_USER=swu_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# swu_app: RLS-aware role (NOSUPERUSER, NOBYPASSRLS), created by migration 0019
APP_DB_PASSWORD=changeme_app

# Constructed by docker-compose.yml — set here for reference only
DATABASE_URL=postgresql://swu_user:changeme@db:5432/swu_inventory
APP_DATABASE_URL=postgresql://swu_app:changeme_app@db:5432/swu_inventory

# Self-hosted card images (BL-76 / ADR-0012) — set per env on Cloud Run, unset locally.
# When unset, /images/ requests fail server-side and the frontend's one-shot onError
# fallback serves the official-CDN URL instead; local dev needs no GCP credentials.
# CARD_IMAGES_BUCKET=swu-dev-jbapps-card-images
