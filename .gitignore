# BL-170: swuapi exports live in the private repo-assets bucket, never in
# git. CI fetches exports/swuapi_export_current.json at image-build time;
# local dev uses scripts/fetch_bootstrap_export.sh. See data/README.md.
backend/app/ingestion/data/*.json

# ── BL-177: the private engineering layer ─────────────────────────────────
# Working records and practice docs live at these same paths on disk but
# are tracked by the private companion repo (SWU-Inventory-Manager-internal)
# via a second git-dir (.git-internal) over this worktree. The per-path
# ignore rules live in .git/info/exclude (local, not tracked) because a
# tracked .gitignore would ALSO apply to the companion repo's view of this
# worktree and outrank its own excludes. Fresh clones don't carry the
# private files, so nothing is lost by keeping these rules local; the
# companion-clone setup doc in the internal repo restores them.
.git-internal/

# Firebase auth-emulator export fallbacks (the durable store lives in the
# compose volume; these appear in the emulator cwd only on export-path
# failures and are local auth dumps that must never be committed)
frontend/firebase-export-*/
